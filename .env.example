# ─── Database ────────────────────────────────────────────────────────────
# PostgreSQL (required — SQLite is not supported)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rekonstrike

# ─── LLM Providers ───────────────────────────────────────────────────────
# At least one is required for the autonomous agent. Set via env vars or .env.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GOOGLE_API_KEY=...

# ─── Redis (Task Queue) ───────────────────────────────────────────────────
# Optional — falls back to direct execution if unavailable
# REDIS_URL=redis://localhost:6379/0
