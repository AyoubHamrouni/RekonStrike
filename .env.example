# ─── Database ────────────────────────────────────────────────────────────
# Default: SQLite (file-based, no config needed)
# For production, switch to PostgreSQL:
# RS_DB_TYPE=postgresql
# RS_DB_HOST=localhost
# RS_DB_PORT=5432
# RS_DB_USER=rekonstrike
# RS_DB_PASSWORD=rekonstrike
# RS_DB_NAME=rekonstrike

# ─── Redis (Task Queue) ───────────────────────────────────────────────────
# Optional — falls back to direct execution if unavailable
# RS_REDIS_URL=redis://localhost:6379/0

# ─── Tool Execution ───────────────────────────────────────────────────────
# native: Run tools directly on the host (requires Go tools installed)
# docker: Run tools in isolated Docker containers
# RS_TOOL_MODE=native

# ─── API Keys ─────────────────────────────────────────────────────────────
# Get these from the respective services
# RS_API_KEYS__SECURITYTRAILS=your_api_key_here
# RS_API_KEYS__GITHUB=your_github_token
# RS_API_KEYS__WHOISXMLAPI=your_api_key_here
# RS_API_KEYS__SHODAN=your_api_key_here
# RS_API_KEYS__CENSYS=your_api_key_here

# ─── Server ───────────────────────────────────────────────────────────────
# Leave empty to disable authentication (dev mode)
# RS_SERVER_API_KEY=change_me_in_production

# ─── Scan Limits ──────────────────────────────────────────────────────────
# RS_MAX_SUBDOMAINS=5000
# RS_MAX_LIVE_SERVERS=500
# RS_TOOL_TIMEOUT=600
# RS_TOOL_CONCURRENCY=20
