# ─── Database ────────────────────────────────────────────────────────────
# PostgreSQL (required — SQLite is not supported)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rekonstrike

# ─── LLM Providers ───────────────────────────────────────────────────────
# At least one is required for the autonomous agent. Set via env vars or .env.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GOOGLE_API_KEY=...

# ─── Redis (Task Queue) ───────────────────────────────────────────────────
# Optional — falls back to direct execution if unavailable
# REDIS_URL=redis://localhost:6379/0

# ─── Platform API Keys (optional) -----------------------------------------
# Provide platform-specific API keys using the RS_PLATFORM_KEYS__* prefix.
# Example: RS_PLATFORM_KEYS__HACKERONE=your_hackerone_api_key
# Multiple platforms may be provided; keys are loaded into `platform_api_keys` map.

# ─── AI Provider Keys & Base URLs (optional) ------------------------------
# Provide AI service keys using the RS_AI_KEYS__* env var prefix.
# Example: RS_AI_KEYS__ANTHROPIC=sk-anthropic-...
# Provide base API URLs (if needed) using RS_AI_URLS__* prefix.
# Example: RS_AI_URLS__ANTHROPIC=https://api.anthropic.com

# ─── Other runtime config -------------------------------------------------
# Maximum number of subdomains to keep in memory (default: 50000)
# MAX_SUBDOMAINS=50000

# Storage directory for collected data (default: ./data)
# DATA_DIR=./data

# Optional scope file path (relative to repo or absolute)
# SCOPE_FILE=./data/scope.json

# Platform/program handle (optional)
# PLATFORM=
# PROGRAM_HANDLE=

# Database type hint (default: postgresql)
# DB_TYPE=postgresql

# Authentication artefacts used by UI (optional)
# AUTH_COOKIE=rekonstrike_auth
# AUTH_TOKEN=eyJhbGciOi...
# AUTH_LOCAL_STORAGE=rekonstrike_auth
